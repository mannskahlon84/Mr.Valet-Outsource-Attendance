DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manpower
# development | production. Production refuses to start with SQLite or a weak SECRET_KEY.
ENVIRONMENT=development
# Production: a random value of 32+ characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=development_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Demo accounts (all with a published password) on an empty database. Defaults: on in development, off in production.
# AUTO_SEED=false

# Browser origins allowed to call the API directly, comma-separated. Leave unset in production when the
# web app uses its /api/v1 proxy (BACKEND_INTERNAL_URL); defaults to "*" in development only.
# ALLOWED_ORIGINS=https://app.example.com

# Public address of the web app, used in password-reset emails
FRONTEND_URL=http://localhost:3000

# Outgoing email for password resets (required in production for "Forgot password" to work)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Mr. Valet <no-reply@example.com>
# SMTP_USE_TLS=true

# Failed-login lockout (defaults shown)
# LOGIN_MAX_FAILURES_PER_USER=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_LOCKOUT_MINUTES=15
